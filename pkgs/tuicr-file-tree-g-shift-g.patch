+#[test]
+fn should_select_first_and_last_tree_rows_with_g_and_shift_g() {
+    let mut app = app_with(&["a.rs", "b.rs", "c.rs"]);
+    app.focused_panel = FocusedPanel::FileList;
+    app.file_list_state.select(1);
+    let diff_cursor = app.diff_state.cursor_line;
+
+    crate::handler::handle_file_list_action(&mut app, Action::GoToBottom);
+    assert_eq!(selected_path(&app), "c.rs");
+
+    crate::handler::handle_file_list_action(&mut app, Action::GoToTop);
+    assert_eq!(app.file_list_state.selected(), 0);
+
+    assert_eq!(
+        app.diff_state.cursor_line, diff_cursor,
+        "g/G in the tree move only the tree selection, like j/k"
+    );
+}
