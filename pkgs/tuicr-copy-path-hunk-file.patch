diff --git a/src/app/yank.rs b/src/app/yank.rs
new file mode 100644
index 0000000..ea9fb1b
--- /dev/null
+++ b/src/app/yank.rs
@@ -0,0 +1,179 @@
+use super::*;
+use crate::model::{DiffFile, DiffHunk, FileStatus, LineOrigin};
+
+impl App {
+    /// The file `<leader>p` / `<leader>y` / `<leader>Y` act on: the selected tree row while the file
+    /// tree is focused, otherwise the file under the diff cursor.
+    fn yank_target_file_idx(&self) -> Option<usize> {
+        if self.focused_panel == FocusedPanel::FileList {
+            return match self.get_selected_tree_item()? {
+                FileTreeItem::File { file_idx, .. } => Some(file_idx),
+                FileTreeItem::Directory { .. } => None,
+            };
+        }
+        match self.line_annotations.get(self.diff_state.cursor_line)? {
+            AnnotatedLine::HunkHeader { file_idx, .. }
+            | AnnotatedLine::DiffLine { file_idx, .. }
+            | AnnotatedLine::SideBySideLine { file_idx, .. } => Some(*file_idx),
+            _ if self.is_cursor_in_overview() => None,
+            _ => Some(self.diff_state.current_file_idx),
+        }
+    }
+
+    fn copy_to_clipboard_with_message(&mut self, text: &str, what: String) {
+        match crate::output::copy_text_to_clipboard(text) {
+            Ok(true) => self.set_message(format!("Copied {what} (via terminal)")),
+            Ok(false) => self.set_message(format!("Copied {what}")),
+            Err(e) => self.set_warning(format!("Copy failed: {e}")),
+        }
+    }
+
+    /// `<leader>p` / `:name`: copy the focused file's repo-relative path.
+    pub fn copy_current_file_path(&mut self) {
+        let Some(path) = self
+            .yank_target_file_idx()
+            .and_then(|idx| self.diff_files.get(idx))
+            .map(|file| file.display_path().display().to_string())
+        else {
+            return self.set_message("No file at cursor");
+        };
+        self.copy_to_clipboard_with_message(&path, path.clone());
+    }
+
+    /// `<leader>y` / `:yank hunk`: copy the hunk under the cursor as unified diff text.
+    pub fn copy_hunk_at_cursor(&mut self) {
+        let hunk = match self.line_annotations.get(self.diff_state.cursor_line) {
+            Some(
+                AnnotatedLine::HunkHeader { file_idx, hunk_idx }
+                | AnnotatedLine::DiffLine { file_idx, hunk_idx, .. }
+                | AnnotatedLine::SideBySideLine { file_idx, hunk_idx, .. },
+            ) => self.diff_files.get(*file_idx).and_then(|file| file.hunks.get(*hunk_idx)),
+            _ => None,
+        };
+        let Some(hunk) = hunk else {
+            return self.set_message("No hunk at cursor");
+        };
+        let text = hunk_patch(hunk);
+        let what = format!("hunk {} ({} lines)", hunk.header.trim(), hunk.lines.len());
+        self.copy_to_clipboard_with_message(&text, what);
+    }
+
+    /// `<leader>Y` / `:yank file`: copy every hunk of the focused file as a patch.
+    pub fn copy_file_diff_at_cursor(&mut self) {
+        let Some(file) = self.yank_target_file_idx().and_then(|idx| self.diff_files.get(idx)) else {
+            return self.set_message("No file at cursor");
+        };
+        if file.hunks.is_empty() {
+            let path = file.display_path().display().to_string();
+            return self.set_message(format!("No changes to copy in {path}"));
+        }
+        let text = file_patch(file);
+        let what = format!(
+            "{} hunk{} of {}",
+            file.hunks.len(),
+            if file.hunks.len() == 1 { "" } else { "s" },
+            file.display_path().display()
+        );
+        self.copy_to_clipboard_with_message(&text, what);
+    }
+}
+
+/// One hunk as unified diff text: its `@@` header, then each line with its ` `/`+`/`-` marker.
+pub(crate) fn hunk_patch(hunk: &DiffHunk) -> String {
+    let mut out = String::new();
+    out.push_str(hunk.header.trim_end());
+    out.push('\n');
+    for line in &hunk.lines {
+        out.push(match line.origin {
+            LineOrigin::Context => ' ',
+            LineOrigin::Addition => '+',
+            LineOrigin::Deletion => '-',
+        });
+        out.push_str(line.content.trim_end_matches(['\n', '\r']));
+        out.push('\n');
+    }
+    out
+}
+
+/// A whole file's changes as a patch `git apply` and coding agents understand.
+pub(crate) fn file_patch(file: &DiffFile) -> String {
+    let old = match (file.status, file.old_path.as_ref()) {
+        (FileStatus::Added, _) | (_, None) => "/dev/null".to_string(),
+        (_, Some(path)) => format!("a/{}", path.display()),
+    };
+    let new = match (file.status, file.new_path.as_ref()) {
+        (FileStatus::Deleted, _) | (_, None) => "/dev/null".to_string(),
+        (_, Some(path)) => format!("b/{}", path.display()),
+    };
+    let mut out = format!("--- {old}\n+++ {new}\n");
+    for hunk in &file.hunks {
+        out.push_str(&hunk_patch(hunk));
+    }
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::model::DiffLine;
+    use std::path::PathBuf;
+
+    fn line(origin: LineOrigin, content: &str) -> DiffLine {
+        DiffLine {
+            origin,
+            content: content.to_string(),
+            old_lineno: None,
+            new_lineno: None,
+            highlighted_spans: None,
+        }
+    }
+
+    fn hunk() -> DiffHunk {
+        DiffHunk {
+            header: "@@ -1,3 +1,3 @@ fn main()".to_string(),
+            lines: vec![
+                line(LineOrigin::Context, "fn main() {"),
+                line(LineOrigin::Deletion, "    old();\n"),
+                line(LineOrigin::Addition, "    new();"),
+            ],
+            old_start: 1,
+            old_count: 3,
+            new_start: 1,
+            new_count: 3,
+        }
+    }
+
+    fn file(status: FileStatus, old: Option<&str>, new: Option<&str>) -> DiffFile {
+        DiffFile {
+            old_path: old.map(PathBuf::from),
+            new_path: new.map(PathBuf::from),
+            status,
+            hunks: vec![hunk(), hunk()],
+            is_binary: false,
+            is_too_large: false,
+            is_commit_message: false,
+            content_hash: 0,
+        }
+    }
+
+    #[test]
+    fn should_render_a_hunk_with_diff_markers() {
+        assert_eq!(
+            hunk_patch(&hunk()),
+            "@@ -1,3 +1,3 @@ fn main()\n fn main() {\n-    old();\n+    new();\n"
+        );
+    }
+
+    #[test]
+    fn should_render_a_modified_file_as_a_patch_with_every_hunk() {
+        let patch = file_patch(&file(FileStatus::Modified, Some("src/a.rs"), Some("src/a.rs")));
+        assert!(patch.starts_with("--- a/src/a.rs\n+++ b/src/a.rs\n@@ -1,3 +1,3 @@"));
+        assert_eq!(patch.matches("@@ -1,3 +1,3 @@").count(), 2);
+    }
+
+    #[test]
+    fn should_use_dev_null_for_added_and_deleted_files() {
+        assert!(file_patch(&file(FileStatus::Added, None, Some("new.rs"))).starts_with("--- /dev/null\n+++ b/new.rs\n"));
+        assert!(file_patch(&file(FileStatus::Deleted, Some("gone.rs"), None)).starts_with("--- a/gone.rs\n+++ /dev/null\n"));
+    }
+}
