+    fn numbered(origin: LineOrigin, content: &str, old: Option<u32>, new: Option<u32>) -> DiffLine {
+        DiffLine { old_lineno: old, new_lineno: new, ..line(origin, content) }
+    }
+
+    fn numbered_file() -> DiffFile {
+        let mut file = file(FileStatus::Modified, Some("src/a.rs"), Some("src/a.rs"));
+        file.hunks = vec![DiffHunk {
+            lines: vec![
+                numbered(LineOrigin::Context, "fn main() {", Some(10), Some(10)),
+                numbered(LineOrigin::Deletion, "    old();", Some(11), None),
+                numbered(LineOrigin::Addition, "    new();", None, Some(11)),
+                numbered(LineOrigin::Addition, "    more();", None, Some(12)),
+                numbered(LineOrigin::Context, "}", Some(12), Some(13)),
+            ],
+            ..hunk()
+        }];
+        file
+    }
+
+    #[test]
+    fn should_copy_removed_and_added_lines_with_a_path_and_line_header() {
+        // A side-by-side row pairs a deletion (line 1) with an addition (line 2); line 3 is added only.
+        let (text, summary) = selection_diff(&[numbered_file()], &[(0, 0, 1), (0, 0, 2), (0, 0, 3)]).unwrap();
+        assert_eq!(text, "src/a.rs:11-12 (old 11)\n-    old();\n+    new();\n+    more();\n");
+        assert_eq!(summary, "3 diff lines from src/a.rs:11-12 (old 11)");
+    }
+
+    #[test]
+    fn should_keep_context_between_the_first_and_last_selected_lines() {
+        let (text, _) = selection_diff(&[numbered_file()], &[(0, 0, 4), (0, 0, 0)]).unwrap();
+        assert_eq!(text.lines().count(), 6, "header + all five hunk lines");
+        assert!(text.starts_with("src/a.rs:10-13 (old 10-12)\n fn main() {\n-    old();"));
+    }
+
+    #[test]
+    fn should_label_deletion_only_selections_with_old_line_numbers() {
+        let (text, _) = selection_diff(&[numbered_file()], &[(0, 0, 1)]).unwrap();
+        assert_eq!(text, "src/a.rs (old 11)\n-    old();\n");
+    }
+
+    #[test]
+    fn should_have_nothing_to_copy_without_diff_lines() {
+        assert!(selection_diff(&[numbered_file()], &[]).is_none());
+    }
