+impl App {
+    /// Visual `Y`: copy the selected rows as diff text (removed lines too, from either side-by-side
+    /// column) under a `path:lines` header, unlike visual `y`, which copies one side's code only.
+    pub fn copy_visual_selection_as_diff(&mut self) {
+        let Some(sel) = self.visual_selection else {
+            return;
+        };
+        let (start, end) = sel.ordered();
+        let mut rows = Vec::new();
+        for idx in start.annotation_idx..=end.annotation_idx {
+            match self.line_annotations.get(idx) {
+                Some(AnnotatedLine::DiffLine { file_idx, hunk_idx, line_idx, .. }) => {
+                    rows.push((*file_idx, *hunk_idx, *line_idx));
+                }
+                Some(AnnotatedLine::SideBySideLine {
+                    file_idx, hunk_idx, del_line_idx, add_line_idx, ..
+                }) => {
+                    rows.extend(del_line_idx.iter().map(|line| (*file_idx, *hunk_idx, *line)));
+                    rows.extend(add_line_idx.iter().map(|line| (*file_idx, *hunk_idx, *line)));
+                }
+                _ => {}
+            }
+        }
+        let Some((text, summary)) = selection_diff(&self.diff_files, &rows) else {
+            return self.set_message("Nothing to copy: select diff lines");
+        };
+        self.copy_to_clipboard_with_message(&text, summary);
+    }
+}
+
+/// Diff text for selected `(file, hunk, line)` rows: per hunk, every line from the first to the last
+/// selected one (so context in between keeps the snippet readable), in the hunk's own unified order.
+/// Returns the text and a one-line summary of what it holds.
+pub(crate) fn selection_diff(files: &[DiffFile], rows: &[(usize, usize, usize)]) -> Option<(String, String)> {
+    let mut groups: Vec<(usize, usize, usize, usize)> = Vec::new(); // file, hunk, first line, last line
+    for &(file_idx, hunk_idx, line_idx) in rows {
+        match groups.iter_mut().find(|g| g.0 == file_idx && g.1 == hunk_idx) {
+            Some(group) => {
+                group.2 = group.2.min(line_idx);
+                group.3 = group.3.max(line_idx);
+            }
+            None => groups.push((file_idx, hunk_idx, line_idx, line_idx)),
+        }
+    }
+    let mut blocks = Vec::new();
+    let mut total = 0;
+    for (file_idx, hunk_idx, first, last) in groups {
+        let file = files.get(file_idx)?;
+        let lines = file.hunks.get(hunk_idx)?.lines.get(first..=last)?;
+        let span = |numbers: Vec<u32>| match (numbers.iter().min(), numbers.iter().max()) {
+            (Some(lo), Some(hi)) if lo == hi => Some(lo.to_string()),
+            (Some(lo), Some(hi)) => Some(format!("{lo}-{hi}")),
+            _ => None,
+        };
+        let new = span(lines.iter().filter_map(|l| l.new_lineno).collect());
+        let old = span(lines.iter().filter_map(|l| l.old_lineno).collect());
+        let path = file.display_path().display();
+        let mut block = match (&new, &old) {
+            (Some(new), Some(old)) if new == old => format!("{path}:{new}\n"),
+            (Some(new), Some(old)) => format!("{path}:{new} (old {old})\n"),
+            (Some(new), None) => format!("{path}:{new}\n"),
+            (None, Some(old)) => format!("{path} (old {old})\n"),
+            (None, None) => format!("{path}\n"),
+        };
+        for line in lines {
+            block.push(match line.origin {
+                LineOrigin::Context => ' ',
+                LineOrigin::Addition => '+',
+                LineOrigin::Deletion => '-',
+            });
+            block.push_str(line.content.trim_end_matches(['\n', '\r']));
+            block.push('\n');
+        }
+        total += lines.len();
+        blocks.push(block);
+    }
+    let first_header = blocks.first()?.lines().next()?.to_string();
+    let summary = if blocks.len() == 1 {
+        format!("{total} diff lines from {first_header}")
+    } else {
+        format!("{total} diff lines from {} places, starting {first_header}", blocks.len())
+    };
+    Some((blocks.join("\n"), summary))
+}
